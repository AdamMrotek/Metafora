{
  "name": "metafora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared/contracts",
    "frontend/shared",
    "frontend/call",
    "frontend/dashboard"
  ],
  "scripts": {
    "dev:call": "npm run dev --workspace=@metafora/call",
    "build:call": "npm run build --workspace=@metafora/call",
    "dev:dashboard": "npm run dev --workspace=@metafora/dashboard",
    "build:dashboard": "npm run build --workspace=@metafora/dashboard",
    "typecheck": "tsc -p shared/contracts && tsc -p frontend/call && tsc -p frontend/dashboard",
    "livekit": "livekit-server --dev"
  },
  "engines": {
    "node": ">=20"
  }
}
