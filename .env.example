# Groq — STT, LLM and TTS. One of our two egresses; DATABASE_URL below is the other.
GROQ_API_KEY=

# `dev` tolerates the published SFU credentials below and a missing Groq key.
# Anything else refuses to boot on either — see services/core/config.py.
METAFORA_ENV=dev

# Self-hosted livekit-server. `livekit-server --dev` uses these exact dev credentials.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# What the *browser* is handed, when that differs from what this process dials
# (a deployment may reach the SFU internally). Defaults to LIVEKIT_URL.
# LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud

PORT=3000

# Which protocol the demo link dispatches. Goes away at Phase 5, when a
# clinician picks it per interview.
#   proto_warmup_v1       one question (default) — proves the machinery, 30s
#   proto_preop_short_v1  two questions, one per section, keeps the escalation flag
#   proto_preop_check_v1  the real pre-op interview — two sections, five fields
# DEMO_PROTOCOL_ID=proto_preop_short_v1

# Supabase Postgres — the record: interviews, transcripts, results.
# Empty in dev = JSONL on disk and an in-process store (and `make logs` works).
# Required outside dev. Use the SESSION pooler (:5432), not the transaction
# pooler (:6543) — asyncpg prepares statements and transaction mode breaks them.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth — who may read the record. The issuer and the JWKS URL both
# derive from this one string, and `config.accounts` (seeded by a migration)
# decides which verified addresses have a caseload.
#
# Empty in dev = the clinical routes refuse every caller with 503. Never an open
# door, and never a reason `make dev` or the patient path stops working —
# neither touches a credential. Required outside dev.
# SUPABASE_URL=https://<ref>.supabase.co

# The project's public anon key. Not read by the backend at all: it is what
# `scripts/auth.sh` (and Phase 4's dashboard) needs to reach the sign-in
# endpoint. Publishable by design — the row-level story is `config.accounts`.
# SUPABASE_ANON_KEY=

# Caps on an unauthenticated route that starts an LLM + TTS session per hit.
# MAX_CONCURRENT_SESSIONS=3
# MAX_CALL_SECONDS=900
# RATE_LIMIT_BURST=3
# RATE_LIMIT_WINDOW_S=300
