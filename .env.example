# Groq — the only egress from our infrastructure
GROQ_API_KEY=

# `dev` tolerates the published SFU credentials below and a missing Groq key.
# Anything else refuses to boot on either — see services/core/config.py.
METAFORA_ENV=dev

# Self-hosted livekit-server. `livekit-server --dev` uses these exact dev credentials.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# What the *browser* is handed, when that differs from what this process dials
# (a deployment may reach the SFU internally). Defaults to LIVEKIT_URL.
# LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud

PORT=3000

# Caps on an unauthenticated route that starts an LLM + TTS session per hit.
# MAX_CONCURRENT_SESSIONS=3
# MAX_CALL_SECONDS=900
# RATE_LIMIT_BURST=3
# RATE_LIMIT_WINDOW_S=300
