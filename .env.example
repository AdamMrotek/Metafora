# Groq — STT, LLM and TTS. The first of three egresses; DATABASE_URL and
# SENTRY_DSN below are the other two.
GROQ_API_KEY=

# `dev` tolerates the published SFU credentials below and a missing Groq key.
# Anything else refuses to boot on either — see services/core/config.py.
METAFORA_ENV=dev

# Self-hosted livekit-server. `livekit-server --dev` uses these exact dev credentials.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# What the *browser* is handed, when that differs from what this process dials
# (a deployment may reach the SFU internally). Defaults to LIVEKIT_URL.
# LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud

PORT=3000

# Which protocol the demo link dispatches. Goes away at Phase 5, when a
# clinician picks it per interview.
#   proto_warmup_v1       one question (default) — proves the machinery, 30s
#   proto_preop_short_v1  two questions, one per section, keeps the escalation flag
#   proto_preop_check_v1  the real pre-op interview — two sections, five fields
# DEMO_PROTOCOL_ID=proto_preop_short_v1

# Supabase Postgres — the record: interviews, transcripts, results.
# Empty in dev = JSONL on disk and an in-process store (and `make logs` works).
# Required outside dev. Use the SESSION pooler (:5432), not the transaction
# pooler (:6543) — asyncpg prepares statements and transaction mode breaks them.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth — who may read the record. The issuer and the JWKS URL both
# derive from this one string, and `config.accounts` (seeded by a migration)
# decides which verified addresses have a caseload.
#
# Empty in dev = the clinical routes refuse every caller with 503. Never an open
# door, and never a reason `make dev` or the patient path stops working —
# neither touches a credential. Required outside dev.
# SUPABASE_URL=https://<ref>.supabase.co

# The project's public browser key. Nothing here verifies with it: it is what a
# *browser* needs to reach the sign-in endpoint, and `GET /config` hands it to
# the dashboard rather than the dashboard baking it into a bundle — so rotating
# it is a secret change, not a rebuild of a static site. `scripts/auth.sh` reads
# it too. Publishable by design; the row-level story is `config.accounts`.
#
# Use the **publishable** key (`sb_publishable_…`) from Settings → API Keys, not
# the legacy `anon` JWT — Supabase deprecates the legacy keys at the end of
# 2026. Nothing in this repo decodes the value, so the two are interchangeable.
#
# Empty means `GET /config` answers 503 and the dashboard says so. Deliberately
# not a boot failure: everything config.py refuses to start on would fail a
# patient, and a missing dashboard key would only fail a clinician's sign-in.
# SUPABASE_PUBLISHABLE_KEY=

# Caps on an unauthenticated route that starts an LLM + TTS session per hit.
# MAX_CONCURRENT_SESSIONS=3
# MAX_CALL_SECONDS=900
# RATE_LIMIT_BURST=3
# RATE_LIMIT_WINDOW_S=300

# Sessions per UTC day across every caller. The per-IP limiter above is defeated
# by having more addresses; this is not. Without it the caps still permit three
# calls back to back forever, which on a link anyone can share is a bill nobody
# chose. `0` disables it. In-process, so a restart forgets the count — the
# account-level spend limit at Groq is the real ceiling, not this.
# MAX_SESSIONS_PER_DAY=200

# The off switch. `false` makes POST /session refuse everyone, so closing a
# public demo is `fly secrets set` and not a redeploy — which matters because a
# redeploy is the thing you cannot do calmly at the moment you need this.
# ACCEPTING_SESSIONS=true

# Sentry — failures, and nothing else. The third egress, and the only one that
# carries no part of the product: app.py initialises it to send no request
# bodies (POST /session/{id}/typed is what the patient typed) and to drop
# anything raised inside services/agent/. Empty means no Sentry, which is a
# laptop.
# SENTRY_DSN=

# FLY_MACHINE_ID is set by Fly, never by hand. The browser is handed it and
# returns it as `fly-force-instance-id`, so /session/{id}/typed reaches the
# process that holds the session. Empty everywhere that is not Fly, and empty
# is correct — one machine needs no routing.
